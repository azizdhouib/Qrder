generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  MANAGER
  KITCHEN

  @@map("qr_user_role")
}

enum OrderStatus {
  PLACED
  PREPARING
  READY
  SERVED
  CANCELLED

  @@map("qr_order_status")
}

enum PaymentMethod {
  CASH
  CARD
  OTHER

  @@map("qr_payment_method")
}

/// Affichage TVA sur factures / tickets (prix catalogue en TTC).
enum RestaurantVatMode {
  TTC_FR_10
  TTC_FR_20
  VAT_EXEMPT_ART293B

  @@map("qr_restaurant_vat_mode")
}

model Restaurant {
  id         String         @id @default(cuid())
  name       String
  slug       String         @unique
  currency   String         @default("EUR")
  suspended  Boolean        @default(false)
  createdAt  DateTime       @default(now())
  /// Raison sociale si différente du nom commercial (factures).
  legalName  String?
  addressLine1 String?
  addressLine2 String?
  postalCode String?
  city       String?
  country    String?        @default("FR")
  phone      String?
  /// Email affiché sur factures (contact / facturation).
  billingEmail String?
  siret      String?
  vatNumber  String?
  logoUrl    String?
  /// Texte libre bas de facture (mentions légales personnalisées).
  invoiceFooterLegal String?
  vatMode    RestaurantVatMode @default(TTC_FR_10)
  users      User[]
  tables     Table[]
  floorRooms FloorRoom[]
  categories MenuCategory[]
  items      MenuItem[]
  orders     Order[]
  bills      Bill[]

  @@map("qr_restaurants")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         UserRole   @default(OWNER)
  createdAt    DateTime   @default(now())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  billsRegistered Bill[] @relation("BillRegisteredBy")

  @@map("qr_users")
}

/// Administrateur plateforme (Qrder) — sans restaurant, accès /admin via JWT ou ADMIN_API_KEY.
model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("qr_platform_admins")
}

/// Zone logique du plan (ex. Salle, Terrasse) — pour filtrer et classer les tables.
model FloorRoom {
  id             String     @id @default(cuid())
  name           String
  /// Salle principale du restaurant (une seule) — créée à l’ouverture du compte, non supprimable.
  isDefault      Boolean    @default(false)
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables         Table[]
  createdAt      DateTime   @default(now())

  @@unique([restaurantId, name])
  @@map("qr_floor_rooms")
}

model Table {
  id           String     @id @default(cuid())
  name         String
  qrToken      String
  isActive     Boolean    @default(true)
  /// Position horizontale sur le plan de salle (0–100 % du cadre, centre de la pastille).
  planPosXPct Float?
  /// Position verticale sur le plan de salle (0–100 % du cadre, centre de la pastille).
  planPosYPct Float?
  roomId       String?
  room         FloorRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  bills        Bill[]

  @@unique([restaurantId, qrToken])
  @@map("qr_tables")
}

model MenuCategory {
  id           String     @id @default(cuid())
  name         String
  position     Int        @default(0)
  isActive     Boolean    @default(true)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@map("qr_menu_categories")
}

model MenuItem {
  id           String     @id @default(cuid())
  name         String
  description  String?
  imageUrl     String?
  /// Étiquettes affichées côté client (ex. « Maison », « Vegan ») — max. 12, chaque libellé ≤ 40 car. côté API.
  tags         String[]   @default([])
  priceCents   Int
  isActive     Boolean    @default(true)
  categoryId   String
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  options      MenuItemOption[]
  orderItems   OrderItem[]

  @@map("qr_menu_items")
}

model MenuItemOption {
  id             String   @id @default(cuid())
  name           String
  priceDeltaCents Int     @default(0)
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("qr_menu_item_options")
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  Int
  status       OrderStatus @default(PLACED)
  totalCents   Int
  notes        String?
  /// Nom affiché sur la note / facture (optionnel).
  customerName String?
  /// Nombre de couverts (optionnel).
  covers       Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt
  /// Début du suivi « en cuisine » (fixé à la première entrée en PREPARING, effacé si retour en PLACED).
  preparingStartedAt DateTime?
  /// Renseigné lors de l’encaissement (facture / note de caisse).
  billId       String?
  bill         Bill?       @relation(fields: [billId], references: [id], onDelete: SetNull)
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId      String
  table        Table       @relation(fields: [tableId], references: [id], onDelete: Restrict)
  items        OrderItem[]

  @@unique([restaurantId, orderNumber])
  @@map("qr_orders")
}

/// Encaissement table (une ou plusieurs commandes servies regroupées).
model Bill {
  id                 String        @id @default(cuid())
  restaurantId       String
  restaurant         Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId            String
  table              Table         @relation(fields: [tableId], references: [id], onDelete: Restrict)
  /// Numéro de facture / ticket de caisse, séquentiel par établissement.
  invoiceNumber      Int
  totalCents         Int
  paymentMethod      PaymentMethod
  createdAt          DateTime      @default(now())
  /// Référence transaction / trace caisse (unique).
  paymentReference   String        @unique
  /// Jeton public pour consulter la facture sans compte (QR).
  publicViewToken    String        @unique
  /// Libellé caissier au moment de l’encaissement (ex. email).
  registeredByLabel  String?
  discountCents      Int           @default(0)
  serviceFeeCents    Int           @default(0)
  registeredByUserId String?
  registeredBy       User?         @relation("BillRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: SetNull)
  orders             Order[]

  @@unique([restaurantId, invoiceNumber])
  @@map("qr_bills")
}

model OrderItem {
  id             String                @id @default(cuid())
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  nameSnapshot   String
  orderId        String
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem              @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  options        OrderItemOptionChoice[]

  @@map("qr_order_items")
}

model OrderItemOptionChoice {
  id               String    @id @default(cuid())
  nameSnapshot     String
  priceDeltaCents  Int
  orderItemId      String
  orderItem        OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("qr_order_item_option_choices")
}
